---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = "Pollería El Sabor | El Verdadero Pollo a la Brasa" } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Tipografías de alta gama para gastronomía -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800;900&family=Plus+Jakarta+Sans:wght@400;500;700;800&display=swap" rel="stylesheet">
    <title>{title}</title>
  </head>
  <body class="bg-stone-950 text-stone-100 antialiased font-sans selection:bg-red-600 selection:text-white">
    <slot />
  </body>
</html>